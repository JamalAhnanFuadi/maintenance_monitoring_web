<?xml version="1.0" encoding="utf-8"?>

    <!DOCTYPE urlrewrite
        PUBLIC "-//tuckey.org//DTD UrlRewrite 3.0//EN"
        "http://www.tuckey.org/res/dtds/urlrewrite3.0.dtd">
<urlrewrite>
	<rule>
		<from>^/$</from>
		<to>/WEB-INF/index.jsp</to>
	</rule>
	<rule>
		<from>^/login$</from>
		<to>/login.jsp</to>
	</rule>
	<rule>
		<from>^/departments$</from>
		<to>/WEB-INF/masterdata/department.jsp</to>
	</rule>
	<rule>
		<from>^/staff$</from>
		<to>/WEB-INF/masterdata/staff.jsp</to>
	</rule>
	<rule>
		<from>^/service-levels$</from>
		<to>/WEB-INF/masterdata/service_level.jsp</to>
	</rule>
	<rule>
		<from>^/products$</from>
		<to>/WEB-INF/masterdata/product.jsp</to>
	</rule>
	<rule>
		<from>^/product-brands$</from>
		<to>/WEB-INF/masterdata/product_brand.jsp</to>
	</rule>
	<rule>
		<from>^/product-categories$</from>
		<to>/WEB-INF/masterdata/product_category.jsp</to>
	</rule>
	<rule>
		<from>^/customer$</from>
		<to>/WEB-INF/masterdata/customer.jsp</to>
	</rule>
	<rule>
		<from>^/projects$</from>
		<to>/WEB-INF/maintenance/project.jsp</to>
	</rule>
	<rule>
		<from>^/project-overview$</from>
		<to>/WEB-INF/maintenance/project_overview.jsp</to>
	</rule>



	<rule>
		<from>^/otp-validation</from>
		<to>/WEB-INF/reset_password_otp.jsp</to>
	</rule>
	<rule>
		<from>^/change-password</from>
		<to>/WEB-INF/change_password.jsp</to>
	</rule>
	<rule>
		<from>^/index$</from>
		<to>/WEB-INF/index.jsp</to>
	</rule>


</urlrewrite>